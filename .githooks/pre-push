#!/usr/bin/env bash
#
# Pre-push gate: nothing red leaves this machine.
#
# Enabled per clone by scripts/install-hooks.sh, which points this repo's
# core.hooksPath here. That is deliberate: a global core.hooksPath (git-lfs
# installs one) silently overrides .git/hooks, so a hook dropped there is never
# run. The git-lfs delegations below replicate what the global hooks did, so
# redirecting hooksPath doesn't cost this repo its LFS support.
set -euo pipefail

echo "pre-push: cargo fmt --all --check"
cargo fmt --all --check

# Three feature sets: the default build, the bare core a phone embeds, and
# everything at once (pdf, net, llm). A lint that only fires under one of them
# is still a lint.
for features in "" "--no-default-features" "--all-features"; do
  echo "pre-push: cargo clippy --all-targets ${features} -- -D warnings"
  # shellcheck disable=SC2086 # word splitting of $features is the point
  cargo clippy --all-targets ${features} -- -D warnings
done

echo "pre-push: cargo test --all"
cargo test --all

echo "pre-push: cargo test --all --no-default-features"
cargo test --all --no-default-features

# The in-process PDF writer (Typst) and the Mermaid renderer: off by default, so the
# two runs above never reach their tests.
echo "pre-push: cargo test --all --features pdf,mermaid"
cargo test --all --features pdf,mermaid

echo "pre-push: cargo doc (warnings are errors)"
RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features --quiet

# Cross-device proof: the core library type-checks for iOS and Android. No
# linker is needed for `cargo check`, but the target's standard library is, and
# Homebrew's rustc (often first on PATH) ships none — so use rustup's toolchain
# explicitly, in a target dir of its own so its different rustc does not
# invalidate the main build cache.
if command -v rustup >/dev/null 2>&1; then
  rustc_bin="$(rustup which rustc --toolchain stable)"
  cargo_bin="$(rustup which cargo --toolchain stable)"
  for target in aarch64-apple-ios aarch64-linux-android; do
    if ! rustup target list --installed --toolchain stable | grep -qx "$target"; then
      rustup target add "$target" --toolchain stable
    fi
    echo "pre-push: cargo check --lib --no-default-features --target ${target}"
    RUSTC="$rustc_bin" CARGO_TARGET_DIR="$(git rev-parse --show-toplevel)/target/cross" \
      "$cargo_bin" check --lib --no-default-features --target "$target" --quiet
    # With the PDF writer and Mermaid too. Typst's `psm` assembles a few lines with the
    # target's C toolchain: the host clang can do it for both targets (an app build
    # uses Xcode's or the NDK's), with the host `ar` to archive the object.
    echo "pre-push: cargo check --lib --no-default-features --features pdf,mermaid --target ${target}"
    CC_aarch64_linux_android=clang AR_aarch64_linux_android=ar \
      RUSTC="$rustc_bin" CARGO_TARGET_DIR="$(git rev-parse --show-toplevel)/target/cross" \
      "$cargo_bin" check --lib --no-default-features --features pdf,mermaid --target "$target" --quiet
  done
else
  echo "pre-push: rustup not found — cross-device check skipped (CI still runs it)" >&2
fi

# The checks above build against the committed Cargo.lock and therefore
# cannot see a dependency range that has gone bad for everyone downstream.
echo "pre-push: fresh resolve (no Cargo.lock)"
"$(git rev-parse --show-toplevel)/scripts/check-fresh-resolve.sh"

echo "pre-push: OK"

# Run last: on a rejected push there is no point uploading LFS objects first.
if command -v git-lfs >/dev/null 2>&1; then
  git lfs pre-push "$@"
fi
